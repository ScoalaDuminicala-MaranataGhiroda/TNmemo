# Conexiune Turso (libSQL)
# Daca lasi necompletat local, aplicatia ruleaza automat in Modul Demo Local (localStorage) cu date preincarcate!
VITE_TURSO_DATABASE_URL=libsql://numele-bazei-tale.turso.io
VITE_TURSO_AUTH_TOKEN=tokenul-tau-jwt-de-la-turso

# Parola initiala pentru panoul de Admin (poate fi schimbata si direct din interfata Admin)
VITE_ADMIN_PASSWORD=talantul
